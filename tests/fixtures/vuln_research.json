  "research_resources": {
    "items": [
      {
        "resource_id": "candidate_4e86bfcf6a5bb3d8d631",
        "subject": "SonicWall SMA 1000 pre-auth to root exploit chain: CVE-2026-15409 /wsproxy SSRF chained with CVE-2026-15410 path traversal, weaponized by INC Ransomware",
        "summary": "Resecurity provides a consolidated technical analysis of two chained SonicWall SMA 1000 zero-days exploited in the wild since June 2026. The report reconstructs the source-code-level root cause of both vulnerabilities: CVE-2026-15409 is a pre-authentication /wsproxy SSRF that allows unauthenticated WebSocket tunneling to localhost-only services via spoofed client identifiers (User-Agent: SMA Connect Agent, bmID=-3389); CVE-2026-15410 is a path-traversal flaw in the remove_hotfix workflow of ctrl-service that concatenates caller-supplied paths without normalization, allowing traversal sequences to resolve to attacker-controlled files executed as root. The full attack chain is detailed step-by-step from a single unauthenticated HTTP request through CouchDB interaction, staged payload execution, and root privilege escalation. Post-exploitation malware analysis covers ROOTRUN (setuid root backdoor), KNUCKLEBALL (Python injector loading embedded JAR archives into legitimate SonicWall JVM processes), Suo5 (HTTP proxy for covert tunneling), and ORANGETAIL (custom Java web shell with AES-encrypted C2). The report links the exploitation cluster to INC Ransomware, documents attacker infrastructure including a pressure-tactic domain (helprans.com), and provides IOCs and defensive recommendations. An additional non-CVE-assigned weakness is documented: the ctrl-service password is derived from the world-readable hardware UUID on physical appliances. The SonicWall PSIRT advisory and Rapid7 independent analysis corroborate the vulnerability details, exploit chain, and active exploitation.",
        "url": "https://www.resecurity.com/blog/article/from-wsproxy-to-root-inc-ransomware-and-sonicwall-sma-exploit-chain",
        "title": "From WSProxy to Root: INC ransomware and SonicWall SMA Exploit Chain",
        "resource_type": "research",
        "provider": "resecurity.com",
        "author_or_org": "Resecurity",
        "published_at": "2026-08-01",
        "claims": [
          {
            "category": "root_cause",
            "statement": "CVE-2026-15409: The /wsproxy WebSocket-to-TCP proxy handler accepts attacker-controlled host, port, and serviceType parameters without authentication, origin validation, or backend whitelisting, allowing unauthenticated external attackers to open WebSocket tunnels to localhost-only services.",
            "support": "source_stated",
            "source_urls": [
              "https://www.resecurity.com/blog/article/from-wsproxy-to-root-inc-ransomware-and-sonicwall-sma-exploit-chain"
            ]
          },
          {
            "category": "root_cause",
            "statement": "CVE-2026-15410: The remove_hotfix workflow in ctrl-service concatenates the caller-supplied hotfix path without normalization or chroot, allowing path-traversal sequences to resolve to attacker-controlled files outside the hotfix directory, which are then chmod'd and executed as root.",
            "support": "source_stated",
            "source_urls": [
              "https://www.resecurity.com/blog/article/from-wsproxy-to-root-inc-ransomware-and-sonicwall-sma-exploit-chain"
            ]
          },
          {
            "category": "exploit_chain",
            "statement": "The full attack chain proceeds: (1) unauthenticated WebSocket upgrade to /wsproxy with spoofed bmID=-3389 and SMA Connect Agent User-Agent; (2) tunnel to Erlang/CouchDB on localhost:1050; (3) CouchDB interaction to read/write files as couchdb user; (4) stage payload in /tmp; (5) invoke sysCtrl.execRemoveHotfix with path traversal to execute the staged script as root; (6) deploy KNUCKLEBALL, Suo5, and ORANGETAIL malware with persistence via /etc/init.d/workplace and /var/lib/unit/conf.json.",
            "support": "source_stated",
            "source_urls": [
              "https://www.resecurity.com/blog/article/from-wsproxy-to-root-inc-ransomware-and-sonicwall-sma-exploit-chain"
            ]
          },
          {
            "category": "exploitation_observation",
            "statement": "Pre-disclosure exploitation by threat actor UTA0533 began on June 22, 2026, before the July 14, 2026 advisory. INC Ransomware has since emerged as the dominant actor weaponizing the full chain, with multiple new victims published on their DLS between July 17 and August 1, 2026 across Australia, US, UAE, Colombia, Switzerland, and other countries.",
            "support": "source_stated",
            "source_urls": [
              "https://www.resecurity.com/blog/article/from-wsproxy-to-root-inc-ransomware-and-sonicwall-sma-exploit-chain"
            ]
          },
          {
            "category": "technical_detail",
            "statement": "On physical SMA appliances, the ctrl-service Basic-auth password is derived from the world-readable /sys/class/dmi/id/product_uuid, allowing any local user or service account to compute administrative credentials after obtaining a low-privilege foothold.",
            "support": "source_stated",
            "source_urls": [
              "https://www.resecurity.com/blog/article/from-wsproxy-to-root-inc-ransomware-and-sonicwall-sma-exploit-chain"
            ]
          },
          {
            "category": "technical_detail",
            "statement": "Post-exploitation malware includes KNUCKLEBALL (Python injector loading embedded JAR archives into legitimate SonicWall processes), Suo5 (open-source HTTP proxy for covert tunneling), and ORANGETAIL (custom Java web shell similar to Behinder with encrypted C2 over HTTPS), all injected into memory to reduce forensic footprint.",
            "support": "source_stated",
            "source_urls": [
              "https://www.resecurity.com/blog/article/from-wsproxy-to-root-inc-ransomware-and-sonicwall-sma-exploit-chain"
            ]
          }
        ],
