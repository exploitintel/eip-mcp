# Install as /etc/eip-v3/eip-mcp-v3.env with mode 0600.
EIP_API_BASE_URL=http://127.0.0.1:13002

# Required for --transport streamable-http, and intentionally left empty here:
# there is no correct default, and a wrong one would be worse than none.
#
# Set it to every Host header value the endpoint answers to, comma-separated. The
# proxy forwards the public name, so that is the name to list - not 127.0.0.1,
# which is only what the process binds. Write explicit entries and list both forms
# of a name - 'mcp.example.com,mcp.example.com:443' - because an entry without a
# port matches only a Host header without one.
#
# Entries are compared to the Host header exactly. Notes on '*', which is not the
# wildcard it looks like:
#   - ':*' is a PREFIX test, not a port wildcard. 'mcp.example.com:*' accepts
#     'mcp.example.com:8080' and equally 'mcp.example.com:8080.evil.com'. Use
#     explicit ports.
#   - '*.example.com' matches the literal string '*.example.com', no subdomains.
#   - A bare '*' is rejected at startup: it looks like "allow everything" and
#     actually matches only a Host header of exactly '*'.
# Entries are lowercased and accepted with or without a trailing root dot. The
# incoming header is still compared byte-for-byte, so a mixed-case Host gets 421.
#
# DNS-rebinding protection is always on, and an empty SDK allowlist rejects every
# Host. The server refuses to start while this is unset so a missing public-host
# configuration is reported immediately instead of starting an endpoint that
# returns 421 to every real request.
EIP_MCP_ALLOWED_HOSTS=

# Optional. Comma-separated Origin header values accepted from browser clients.
# Left empty, an absent Origin (every non-browser MCP client) is accepted and any
# present Origin is refused, so the empty value is the closed one.
#EIP_MCP_ALLOWED_ORIGINS=

# Optional, both defaulted in code.
#EIP_MCP_TIMEOUT_SECONDS=30
#EIP_MCP_MAX_OUTPUT_CHARS=40000
#EIP_MCP_MAX_CONCURRENT_API_REQUESTS=8
